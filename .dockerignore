# Version control
.git
.gitignore
.gitattributes

# Python artefacts
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
*.egg-info
dist
build

# Virtual environments
.venv
venv
env

# Secrets — never bake credentials into the image
.env
.env.local
*service-account*.json
*-key.json
credentials.json

# Reflex runtime artefacts (regenerated by `reflex init` during the build)
.web
.states
reflex.db
node_modules

# Bulk data — the derived catalogue IS needed, its raw inputs are not.
# data/ifn_points.csv and data/ifn_points.meta.json must stay in the image.
data/raw
data/cache

# Not needed to run the service
tests
doc
scripts
*.md
!README.md

# Editor / OS
.vscode
.idea
.DS_Store
*.swp
