# Naturametrics — copy to .env and adjust. See README "Configuration".

# --- Earth Engine ---------------------------------------------------------
# The Partner-tier grant is attached to this project specifically (decision D5).
GCP_PROJECT_ID=ee-leandromet
NM_EE_TIER=partner
NM_EE_CONCURRENCY=64

# Local dev uses Application Default Credentials — run `earthengine authenticate`.
# Cloud Run has no ADC file and uses these instead (from Secret Manager):
# EE_SERVICE_ACCOUNT_EMAIL=naturametrics@ee-leandromet.iam.gserviceaccount.com
# EE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# EE_PRIVATE_KEY_ID=
# EE_CLIENT_ID=
# EE_SERVICE_ACCOUNT_JSON=/path/to/key.json

# --- Map ------------------------------------------------------------------
NM_BASEMAP=esri_imagery

# --- Feature flags --------------------------------------------------------
# SPOT 2008 needs Google's licence agreement accepted for the running account.
NM_SPOT_ENABLED=false

# --- Analysis -------------------------------------------------------------
NM_HANSEN_TREECOVER_THRESHOLD=30
NM_IFN_CATALOG=data/ifn_points.csv

# --- Abuse control (services/abuse_control.py, doc/13-abuse-control.md) ---
# Rate limiting and access logging for the bulk export. Uses the same Earth
# Engine service-account credentials as everything else (implicit ADC locally,
# the attached runtime service account on Cloud Run) — no separate key needed.
NM_ABUSE_BUCKET=naturametrics-abuse-control
NM_ABUSE_SESSION_COOLDOWN_S=300
NM_ABUSE_IP_MAX_PER_WINDOW=3
NM_ABUSE_IP_WINDOW_S=3600

# --- GBIF occurrences (services/gbif.py) ----------------------------------
# The layer reads GBIF's public REST API — no key, no BigQuery, no cost. See
# naturametrics/config/gbif.py for why the BigQuery public dataset was not used.
NM_GBIF_MIN_ZOOM=10
NM_GBIF_MAX_PAGES=1
NM_GBIF_CACHE_TTL_S=900

# --- Server ---------------------------------------------------------------
PORT=3010
BACKEND_PORT=8011
REFLEX_LOG_LEVEL=info
